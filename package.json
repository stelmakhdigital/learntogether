{
	"name": "learntogether",
	"version": "0.0.0",
	"private": true,
	"description": "Local-first understanding trainer: probing, minimal dependency plan, one reasoning step at a time, knowledge graph, spaced practice.",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=24.0.0 <25.0.0"
	},
	"packageManager": "pnpm@10.34.9",
	"scripts": {
		"test": "node --test packages/*/test/*.test.ts packages/*/test/*/*.test.ts apps/*/test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"check:layers": "node scripts/check-layers.mjs",
		"verify": "pnpm lint && pnpm check:layers && pnpm typecheck && pnpm test",
		"build": "pnpm -r --if-present build",
		"screens": "node scripts/screens.mjs",
		"desktop:smoke": "node scripts/desktop-smoke.mjs"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"eslint": "10.15.0",
		"playwright": "1.65.1",
		"ts-fsrs": "6.0.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.74.0"
	}
}
